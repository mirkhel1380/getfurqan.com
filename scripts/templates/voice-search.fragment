<div class="voice-search" data-voice-search data-voice-input="__INPUT__"><label>Voice language<select aria-label="Voice language"><option value="en-US">English</option><option value="ar-SA">Arabic</option></select></label><button type="button" data-voice-toggle aria-pressed="false" disabled>Start voice search</button><p data-voice-status role="status" aria-live="polite"></p><small>Your browser may send audio to its speech service. Review the text before searching.</small></div>
